&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> &lt;span class="n">userBBB_PASSWORD&lt;/span> &lt;span class="s2">&amp;#34;xxxxxxxxxx&amp;#34;&lt;/span>
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> &lt;span class="n">userBBB_PASSWORD_GEN&lt;/span> &lt;span class="s2">&amp;#34;xxxxxxxxxx&amp;#34;&lt;/span>
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> &lt;span class="n">userBBB_SECRET&lt;/span> &lt;span class="s2">&amp;#34;xxxxxxxxxx&amp;#34;&lt;/span>
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> &lt;span class="n">userAAA_PASSWORD&lt;/span> &lt;span class="s2">&amp;#34;xxxxxxxxxx&amp;#34;&lt;/span>
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> &lt;span class="n">userAAA_PASSWORD_GEN&lt;/span> &lt;span class="s2">&amp;#34;xxxxxxxxxx&amp;#34;&lt;/span>
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> &lt;span class="n">userAAA_SECRET&lt;/span> &lt;span class="s2">&amp;#34;xxxxxxxxxx&amp;#34;&lt;/span>
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">&lt;span class="p">}&lt;/span>
