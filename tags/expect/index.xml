&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">&lt;span class="n">set&lt;/span> &lt;span class="n">USERNAME&lt;/span> &lt;span class="o">$&lt;/span>&lt;span class="n">DEFAULT_USER&lt;/span>
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">&lt;span class="n">set&lt;/span> &lt;span class="n">use_authenticator&lt;/span> &lt;span class="mi">0&lt;/span>
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">&lt;span class="c1"># 打印 usage 信息&lt;/span>
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">&lt;span class="n">proc&lt;/span> &lt;span class="n">print_usage&lt;/span> &lt;span class="p">{}&lt;/span> &lt;span class="p">{&lt;/span>
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> &lt;span class="n">puts&lt;/span> &lt;span class="p">{&lt;/span>&lt;span class="n">Usage&lt;/span>&lt;span class="p">:&lt;/span> &lt;span class="n">jump&lt;/span> &lt;span class="p">[&lt;/span>&lt;span class="o">--&lt;/span>&lt;span class="n">user&lt;/span> &lt;span class="o">&amp;lt;&lt;/span>&lt;span class="n">username&lt;/span>&lt;span class="o">&amp;gt;&lt;/span>&lt;span class="p">]&lt;/span> &lt;span class="p">[&lt;/span>&lt;span class="o">--&lt;/span>&lt;span class="n">auth&lt;/span> &lt;span class="o">&amp;lt;&lt;/span>&lt;span class="n">auth_type&lt;/span>&lt;span class="o">&amp;gt;&lt;/span>&lt;span class="p">]&lt;/span> &lt;span class="p">[&lt;/span>&lt;span class="o">--&lt;/span>&lt;span class="n">type&lt;/span> &lt;span class="o">&amp;lt;&lt;/span>&lt;span class="n">link_type&lt;/span>&lt;span class="o">&amp;gt;&lt;/span>&lt;span class="p">]&lt;/span> &lt;span class="p">[&lt;/span>&lt;span class="o">--&lt;/span>&lt;span class="n">help&lt;/span>&lt;span class="p">]}&lt;/span>
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> &lt;span class="n">puts&lt;/span> &lt;span class="p">{&lt;/span>&lt;span class="o">--&lt;/span>&lt;span class="n">user&lt;/span> &lt;span class="o">&amp;lt;&lt;/span>&lt;span class="n">username&lt;/span>&lt;span class="o">&amp;gt;&lt;/span> &lt;span class="n">Specify&lt;/span> &lt;span class="n">the&lt;/span> &lt;span class="n">username&lt;/span> &lt;span class="n">to&lt;/span> &lt;span class="n">use&lt;/span> &lt;span class="p">(&lt;/span>&lt;span class="n">default&lt;/span>&lt;span class="p">:&lt;/span> &lt;span class="o">$&lt;/span>&lt;span class="n">DEFAULT_USER&lt;/span>&lt;span class="p">)}&lt;/span>
